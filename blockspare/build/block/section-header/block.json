    "titlePaddingBottom": {
      "type": "number",
      "default": 0
    },
    "titlePaddingLeft": {
      "type": "number",
      "default": 0
    },
    "subtitlePaddingTop": {
      "type": "number",
      "default": 0
    },
    "subtitlePaddingRight": {
      "type": "number",
      "default": 0
