    "subTitleFontWeight": {
      "type": "string",
      "default": ""
    },
    "subTitleFontSubset": {
      "type": "string"
    },
    "subTitleFontSizeType": {
      "type": "string",
      "default": "px"
    },
    "subTitleFontSizeMobile": {
      "type": "number",
      "default": 14
    },
    "subTitleFontSizeTablet": {
      "type": "number",
      "default": 14
    },
    "subTitleLoadGoogleFonts": {
      "type": "boolean",
      "default": false
    },
    "animation": {
      "type": "string",
      "default": ""
    },
    "blockHoverEffect": {
      "type": "string",
      "default": ""
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
