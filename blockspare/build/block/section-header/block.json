    "titleFontWeight": {
      "type": "string",
      "default": ""
    },
    "titleFontSubset": {
      "type": "string"
    },
    "titleFontSizeType": {
      "type": "string",
      "default": "px"
    },
    "titleFontSizeMobile": {
      "type": "number",
      "default": 20
    },
    "titleFontSizeTablet": {
      "type": "number",
      "default": 22
    },
    "titleLoadGoogleFonts": {
      "type": "boolean",
      "default": false
