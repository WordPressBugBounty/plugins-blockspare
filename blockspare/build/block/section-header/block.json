{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "blockspare/blockspare-section-header",
  "title": "Section Header",
  "category": "blockspare",
  "description": "Create styled headings with sub-titles, badges, and divider lines for page sections.",
  "attributes": {
    "className": {
      "type": "string"
    },
    "uniqueClass": {
      "type": "string",
      "default": ""
    },
    "align": {
      "type": "string",
      "default": "left"
    },
    "sectionAlignment": {
      "type": "string",
      "default": "left"
    },
    "headerTitle": {
      "type": "string",
      "default": "Enter Title"
    },
    "titleFontSize": {
      "type": "number",
      "default": 32
    },
    "headerSubTitle": {
      "type": "string",
      "default": ""
    },
    "headerboxColor": {
      "type": "string",
      "default": "transparent"
    },
    "headertitleColor": {
      "type": "string",
      "default": "#242a56"
    },
    "headertitleColorDark": {
      "type": "string",
      "default": "#fff"
    },
    "headersubtitleColor": {
      "type": "string",
      "default": "#393a56"
    },
    "headertitleDashColor": {
      "type": "string",
      "default": "#6d6d6d"
    },
    "headermarginTop": {
      "type": "number",
      "default": 30
    },
    "headermarginRight": {
      "type": "number",
      "default": 0
    },
    "headermarginBottom": {
      "type": "number",
      "default": 30
    },
    "headermarginLeft": {
      "type": "number",
      "default": 0
    },
    "headerlayoutOption": {
      "type": "string",
      "default": "blockspare-style3"
    },
    "headerTagOption": {
      "type": "string",
      "default": "h2"
    },
    "titlePaddingTop": {
      "type": "number",
      "default": 0
    },
    "titlePaddingRight": {
      "type": "number",
      "default": 0
    },
    "titlePaddingBottom": {
      "type": "number",
      "default": 0
    },
    "titlePaddingLeft": {
      "type": "number",
      "default": 0
    },
    "subtitlePaddingTop": {
      "type": "number",
      "default": 0
    },
    "subtitlePaddingRight": {
      "type": "number",
      "default": 0
    },
    "subtitlePaddingBottom": {
      "type": "number",
      "default": 0
    },
    "subtitlePaddingLeft": {
      "type": "number",
      "default": 0
    },
    "dashColor": {
      "type": "string",
      "default": "#1290f8"
    },
    "dashColor2": {
      "type": "string",
      "default": "#f7f7f7"
    },
    "titleFontFamily": {
      "type": "string",
      "default": "Default"
    },
    "titleFontWeight": {
      "type": "string",
      "default": "700"
    },
    "titleFontSubset": {
      "type": "string"
    },
    "titleFontSizeType": {
      "type": "string",
      "default": "px"
    },
    "titleFontSizeMobile": {
      "type": "number",
      "default": 20
    },
    "titleFontSizeTablet": {
      "type": "number",
      "default": 24
    },
    "titleLoadGoogleFonts": {
      "type": "boolean",
      "default": false
    },
    "subTitleFontSize": {
      "type": "number",
      "default": 16
    },
    "subTitleFontFamily": {
      "type": "string",
      "default": "Default"
    },
    "subTitleFontWeight": {
      "type": "string",
      "default": ""
    },
    "subTitleFontSubset": {
      "type": "string"
    },
    "subTitleFontSizeType": {
      "type": "string",
      "default": "px"
    },
    "subTitleFontSizeMobile": {
      "type": "number",
      "default": 14
    },
    "subTitleFontSizeTablet": {
      "type": "number",
      "default": 14
    },
    "subTitleLoadGoogleFonts": {
      "type": "boolean",
      "default": false
    },
    "animation": {
      "type": "string",
      "default": ""
    },
    "blockHoverEffect": {
      "type": "string",
      "default": ""
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css"
}