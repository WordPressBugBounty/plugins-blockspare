{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "blockspare/blockspare-counter",
  "title": "Counter",
  "category": "blockspare",
  "description": "Showcase numbers and statistics with smooth counting animations",
  "attributes": {
    "className": {
      "type": "string"
    },
    "counter": {
      "type": "number",
      "default": 2500
    },
    "align": {
      "type": "string",
      "default": "center"
    },
    "counterFontColor": {
      "type": "string",
      "default": "#1290f8"
    },
    "backGroundColor": {
      "type": "string",
      "default": "#fff"
    },
    "imageSize": {
      "type": "string",
      "default": "full"
    },
    "showImage": {
      "type": "boolean",
      "default": true
    },
    "imgIconOption": {
      "type": "string",
      "default": "icon"
    },
    "name": {
      "type": "string",
      "default": "fas fa-chart-line"
    },
    "iconSize": {
      "type": "string",
      "default": "blockspare-icon-size-small"
    },
    "iconStyles": {
      "type": "string",
      "default": "blockspare-icon-style2"
    },
    "iconBackgroundColor": {
      "type": "string",
      "default": "#f7f7f7"
    },
    "iconBorderColor": {
      "type": "string",
      "default": "#1290f8"
    },
    "iconColor": {
      "type": "string",
      "default": "#1290f8"
    },
    "borderRadius": {
      "type": "number",
      "default": 15
    },
    "design": {
      "type": "string",
      "default": "blockspare-layout2"
    },
    "blockBorderRadius": {
      "type": "number",
      "default": 15
    },
    "headertitleColor": {
      "type": "string",
      "default": "#000"
    },
    "headersubtitleColor": {
      "type": "string",
      "default": "#6d6d6d"
    },
    "headermarginTop": {
      "type": "number",
      "default": 5
    },
    "headermarginRight": {
      "type": "number",
      "default": 0
    },
    "headermarginBottom": {
      "type": "number",
      "default": 5
    },
    "headermarginLeft": {
      "type": "number",
      "default": 0
    },
    "paddingTop": {
      "type": "number",
      "default": 20
    },
    "paddingBottom": {
      "type": "number",
      "default": 20
    },
    "counterMarginTop": {
      "type": "number",
      "default": 0
    },
    "counterMarginRight": {
      "type": "number",
      "default": 0
    },
    "counterMarginBottom": {
      "type": "number",
      "default": 0
    },
    "counterMarginLeft": {
      "type": "number",
      "default": 0
    },
    "iconMarginTop": {
      "type": "number",
      "default": 0
    },
    "iconMarginRight": {
      "type": "number",
      "default": 0
    },
    "iconMarginBottom": {
      "type": "number",
      "default": 10
    },
    "iconMarginLeft": {
      "type": "number",
      "default": 0
    },
    "iconPaddingTop": {
      "type": "number",
      "default": 30
    },
    "iconPaddingBottom": {
      "type": "number",
      "default": 30
    },
    "iconPaddingLeft": {
      "type": "number",
      "default": 30
    },
    "iconPaddingRight": {
      "type": "number",
      "default": 30
    },
    "openPopover": {
      "type": "boolean",
      "default": false
    },
    "counterFontSize": {
      "type": "number",
      "default": 42
    },
    "counterFontFamily": {
      "type": "string",
      "default": "Default"
    },
    "counterFontWeight": {
      "type": "string",
      "default": "600"
    },
    "counterFontSubset": {
      "type": "string"
    },
    "counterFontSizeType": {
      "type": "string",
      "default": "px"
    },
    "counterFontSizeMobile": {
      "type": "number",
      "default": 20
    },
    "counterFontSizeTablet": {
      "type": "number",
      "default": 26
    },
    "counterLoadGoogleFonts": {
      "type": "boolean",
      "default": false
    },
    "animation": {
      "type": "string",
      "default": ""
    },
    "blockHoverEffect": {
      "type": "string",
      "default": ""
    },
    "backgroundOpacity": {
      "type": "number",
      "default": 1
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "viewScript": "file:./view.js"
}