{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "blockspare/blockspare-price-list",
  "category": "blockspare",
  "attributes": {
    "uniqueClass": {
      "type": "string"
    },
    "className": {
      "type": "string"
    },
    "align": {
      "type": "string"
    },
    "sectionAlignment": {
      "type": "string",
      "default": "wide"
    },
    "uniqueId": {
      "type": "string",
      "default": ""
    },
    "defaultItems": {
      "type": "number",
      "default": 3
    },
    "backgroundColor": {
      "type": "string",
      "default": "transparent"
    },
    "backgroundTransparent": {
      "type": "boolean",
      "default": false
    },
    "marginTop": {
      "type": "number",
      "default": 30
    },
    "marginRight": {
      "type": "number",
      "default": 0
    },
    "marginBottom": {
      "type": "number",
      "default": 30
    },
    "marginLeft": {
      "type": "number",
      "default": 0
    },
    "animation": {
      "type": "string",
      "default": ""
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css"
}